{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "equipment-azure",
    "namespace": "argocd",
    "annotations": {
      "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
    }
  },
  "spec": {
    "project": "equipment-azure",
    "source": {
      "repoURL": "https://github.com/cosminstirbu/equipment-reservations-lab.git",
      "targetRevision": "main",
      "path": "deploy/environments/azure"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "equipment"
    },
    "syncPolicy": {
      "automated": {
        "prune": true,
        "selfHeal": true,
        "allowEmpty": false
      },
      "syncOptions": ["CreateNamespace=false", "FailOnSharedResource=true"],
      "retry": {
        "limit": 2,
        "backoff": {
          "duration": "5s",
          "factor": 2,
          "maxDuration": "20s"
        }
      }
    }
  }
}
