    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "grafana",
        "namespace": "equipment-platform",
        "labels": {
          "app.kubernetes.io/name": "grafana",
          "app.kubernetes.io/part-of": "equipment"
        },
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-40",
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "grafana"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "grafana",
              "app.kubernetes.io/part-of": "equipment",
              "azure.workload.identity/use": "true"
            }
          },
          "spec": {
            "serviceAccountName": "grafana",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "grafana",
                "image": "docker.io/grafana/grafana@sha256:dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f",
                "command": ["/bin/sh", "-ec"],
                "args": ["export CA_CERT=\"$(cat /tls/ca.crt)\"; exec /run.sh"],
                "env": [
                  {
                    "name": "GF_AUTH_ANONYMOUS_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "GF_USERS_ALLOW_SIGN_UP",
                    "value": "false"
                  },
                  {
                    "name": "GF_SERVER_PROTOCOL",
                    "value": "https"
                  },
                  {
                    "name": "GF_SERVER_CERT_FILE",
                    "value": "/tls/tls.crt"
                  },
                  {
                    "name": "GF_SERVER_CERT_KEY",
                    "value": "/tls/tls.key"
                  },
                  {
                    "name": "GF_LOG_LEVEL",
                    "value": "error"
                  },
                  {
                    "name": "GF_ANALYTICS_REPORTING_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "GF_ANALYTICS_CHECK_FOR_UPDATES",
                    "value": "false"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_USER",
                    "value": "operator"
                  },
                  {
                    "name": "GF_SECURITY_ADMIN_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "grafana-credentials",
                        "key": "adminPassword"
                      }
                    }
                  },
                  {
                    "name": "PROMETHEUS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "grafana-credentials",
                        "key": "prometheusToken"
                      }
                    }
                  },
                  {
                    "name": "LOKI_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "grafana-credentials",
                        "key": "lokiToken"
                      }
                    }
                  },
                  {
                    "name": "TEMPO_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "grafana-credentials",
                        "key": "tempoToken"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 3000
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "configuration",
                    "mountPath": "/etc/grafana/provisioning/datasources",
                    "readOnly": true
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/lib/grafana"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "secrets-store",
                    "mountPath": "/mnt/secrets-store",
                    "readOnly": true
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/api/health",
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/api/health",
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/api/health",
                    "scheme": "HTTPS"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "configuration",
                "configMap": {
                  "name": "grafana-datasources"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "grafana-tls"
                }
              },
              {
                "name": "data",
                "emptyDir": {
                  "sizeLimit": "64Mi"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "secrets-store",
                "csi": {
                  "driver": "secrets-store.csi.k8s.io",
                  "readOnly": true,
                  "volumeAttributes": {
                    "secretProviderClass": "grafana"
                  }
                }
              }
            ]
          }
        }
      }
