        },
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-40",
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "grafana"
        },
        "ports": [
          {
            "name": "https",
            "port": 3000,
            "targetPort": 3000
          }
        ]
      }
    }
  ]
