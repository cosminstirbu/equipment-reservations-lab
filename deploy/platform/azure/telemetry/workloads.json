    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "otel-collector",
        "namespace": "equipment-platform",
        "labels": {
          "app.kubernetes.io/name": "otel-collector",
          "app.kubernetes.io/part-of": "equipment"
        },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false",
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "otel-collector"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "otel-collector",
              "app.kubernetes.io/part-of": "equipment",
              "azure.workload.identity/use": "true"
            }
          },
          "spec": {
            "serviceAccountName": "otel-collector",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "otel-collector",
                "image": "ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib@sha256:7f22d2a6748110ffb6a59bc0df448bccbf501cdb667d610ede4c61d3863d5849",
                "args": ["--config=/configuration/collector.yaml"],
                "env": [
                  {
                    "name": "INVENTORY_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "inventoryToken"
                      }
                    }
                  },
                  {
                    "name": "RESERVATIONS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "reservationsToken"
                      }
                    }
                  },
                  {
                    "name": "NOTIFICATIONS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "notificationsToken"
                      }
                    }
                  },
                  {
                    "name": "DATABASE_BOOTSTRAP_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "databaseBootstrapToken"
                      }
                    }
                  },
                  {
                    "name": "IDENTITY_BOOTSTRAP_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "identityBootstrapToken"
                      }
                    }
                  },
                  {
                    "name": "BROKER_BOOTSTRAP_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "brokerBootstrapToken"
                      }
                    }
                  },
                  {
                    "name": "DASHBOARD_OTLP",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "dashboardOtlp"
                      }
                    }
                  },
                  {
                    "name": "PROMETHEUS_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "prometheusToken"
                      }
                    }
                  },
                  {
                    "name": "LOKI_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "lokiToken"
                      }
                    }
                  },
                  {
                    "name": "TEMPO_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "otel-collector-credentials",
                        "key": "tempoToken"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi",
                    "ephemeral-storage": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "384Mi",
                    "ephemeral-storage": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "ports": [
                  {
                    "name": "otlp",
                    "containerPort": 4317
                  },
                  {
                    "name": "health",
                    "containerPort": 13133
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "configuration",
                    "mountPath": "/configuration",
                    "readOnly": true
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "secrets-store",
                    "mountPath": "/mnt/secrets-store",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp",
                    "readOnly": false
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "port": "health",
                    "path": "/",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 36
                },
                "readinessProbe": {
                  "httpGet": {
                    "port": "health",
                    "path": "/",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "port": "health",
                    "path": "/",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 6
                }
              }
            ],
            "volumes": [
              {
                "name": "configuration",
                "configMap": {
                  "name": "otel-collector"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "otel-collector-tls"
                }
              },
              {
                "name": "secrets-store",
                "csi": {
                  "driver": "secrets-store.csi.k8s.io",
                  "readOnly": true,
                  "volumeAttributes": {
                    "secretProviderClass": "otel-collector"
                  }
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
