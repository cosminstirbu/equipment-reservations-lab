{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "prometheus-data",
        "namespace": "equipment-platform",
        "labels": {
          "app.kubernetes.io/name": "prometheus-data",
          "app.kubernetes.io/part-of": "equipment"
        },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false",
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "accessModes": ["ReadWriteOnce"],
        "storageClassName": "equipment-azure-retain",
        "resources": {
          "requests": {
            "storage": "8Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "prometheus",
        "namespace": "equipment-platform",
        "labels": {
          "app.kubernetes.io/name": "prometheus",
          "app.kubernetes.io/part-of": "equipment"
        },
        "annotations": {
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false",
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "prometheus"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "prometheus",
              "app.kubernetes.io/part-of": "equipment",
              "azure.workload.identity/use": "true"
            }
          },
          "spec": {
            "serviceAccountName": "prometheus",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prometheus",
                "image": "quay.io/prometheus/prometheus@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2",
                "args": [
                  "--config.file=/configuration/prometheus.yaml",
                  "--storage.tsdb.path=/data",
                  "--storage.tsdb.retention.time=72h",
                  "--storage.tsdb.retention.size=6GB",
                  "--web.enable-otlp-receiver",
                  "--web.listen-address=0.0.0.0:9090",
                  "--log.level=error"
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi",
                    "ephemeral-storage": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "768Mi",
                    "ephemeral-storage": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "ports": [
                  {
                    "name": "backend",
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "configuration",
                    "mountPath": "/configuration",
                    "readOnly": true
                  },
                  {
                    "name": "data",
                    "mountPath": "/data",
                    "readOnly": false
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp",
                    "readOnly": false
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "port": "backend",
                    "path": "/-/ready",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "port": "backend",
                    "path": "/-/ready",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "port": "backend",
                    "path": "/-/healthy",
                    "scheme": "HTTP"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 6
                }
              },
              {
                "name": "authentication-proxy",
                "image": "docker.io/nginxinc/nginx-unprivileged@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6",
                "command": ["/bin/sh", "-ec"],
                "args": [
                  "envsubst '$API_TOKEN' < /proxy/nginx.conf.template > /tmp/nginx.conf; exec nginx -c /tmp/nginx.conf -g 'daemon off;'"
                ],
                "env": [
                  {
                    "name": "API_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "prometheus-credentials",
                        "key": "apiToken"
                      }
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "20m",
                    "memory": "24Mi",
                    "ephemeral-storage": "64Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi",
                    "ephemeral-storage": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "ports": [
                  {
                    "name": "https",
                    "containerPort": 8443
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "proxy",
                    "mountPath": "/proxy",
                    "readOnly": true
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  },
                  {
                    "name": "proxy-tmp",
                    "mountPath": "/tmp",
                    "readOnly": false
                  },
                  {
                    "name": "secrets-store",
                    "mountPath": "/mnt/secrets-store",
                    "readOnly": true
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/healthz",
                    "scheme": "HTTPS"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "readinessProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/healthz",
                    "scheme": "HTTPS"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "port": "https",
                    "path": "/livez",
                    "scheme": "HTTPS"
                  },
                  "timeoutSeconds": 2,
                  "periodSeconds": 5,
                  "failureThreshold": 3
                }
              }
            ],
            "volumes": [
              {
                "name": "configuration",
                "configMap": {
                  "name": "prometheus"
                }
              },
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "prometheus-data"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "proxy-tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "16Mi"
                }
              },
              {
                "name": "proxy",
                "configMap": {
                  "name": "prometheus-proxy"
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "prometheus-tls"
                }
              },
              {
                "name": "secrets-store",
                "csi": {
                  "driver": "secrets-store.csi.k8s.io",
                  "readOnly": true,
                  "volumeAttributes": {
                    "secretProviderClass": "prometheus"
                  }
                }
              }
            ]
          }
        }
      }
    },
