{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "equipment-recovery-deny-default",
        "namespace": "equipment-recovery"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": ["Ingress", "Egress"]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "equipment-recovery-dns",
        "namespace": "equipment-recovery"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
