{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "equipment-backup-client",
        "namespace": "equipment-recovery",
        "labels": {
          "app.kubernetes.io/name": "equipment-backup-client",
          "azure.workload.identity/use": "true"
        },
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-10",
          "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
        }
      },
      "spec": {
        "serviceAccountName": "equipment-backup-client",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 999,
          "runAsGroup": 999,
          "fsGroup": 999,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "client",
            "image": "docker.io/library/postgres@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336",
            "command": ["sleep", "infinity"],
            "env": [
              {
                "name": "PGHOST",
                "value": "postgres.equipment.svc.cluster.local"
              },
              {
                "name": "PGPORT",
                "value": "5432"
              },
              {
                "name": "PGDATABASE",
                "value": "inventory"
              },
              {
                "name": "PGCONNECT_TIMEOUT",
                "value": "5"
              },
              {
                "name": "PGUSER",
                "value": "equipment_backup"
              },
              {
                "name": "PGPASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "equipment-backup-client-credentials",
                    "key": "postgresPassword"
                  }
                }
              },
              {
                "name": "VERIFY_PGUSER",
                "value": "verification_admin"
              },
              {
                "name": "VERIFY_PGPASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "equipment-backup-client-credentials",
                    "key": "verificationPassword"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "512Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": ["ALL"]
              }
            },
            "startupProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-ec",
                  "psql -X --set ON_ERROR_STOP=1 -Atc \"SELECT 1\" >/dev/null 2>&1"
                ]
              },
              "periodSeconds": 5,
              "timeoutSeconds": 6,
              "failureThreshold": 60
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-ec",
                  "psql -X --set ON_ERROR_STOP=1 -Atc \"SELECT 1\" >/dev/null 2>&1"
                ]
              },
              "periodSeconds": 5,
              "timeoutSeconds": 6,
              "failureThreshold": 3
            },
            "livenessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-ec",
                  "psql -X --set ON_ERROR_STOP=1 -Atc \"SELECT 1\" >/dev/null 2>&1"
                ]
              },
              "periodSeconds": 5,
              "timeoutSeconds": 6,
              "failureThreshold": 3
            },
            "volumeMounts": [
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "run",
                "mountPath": "/var/run/postgresql"
              },
              {
                "name": "credentials",
                "mountPath": "/mnt/secrets-store",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "16Mi"
            }
          },
          {
            "name": "run",
            "emptyDir": {
              "sizeLimit": "8Mi"
            }
          },
          {
            "name": "credentials",
            "csi": {
              "driver": "secrets-store.csi.k8s.io",
              "readOnly": true,
              "volumeAttributes": {
                "secretProviderClass": "equipment-backup-client"
              }
            }
          }
        ]
      }
    },
