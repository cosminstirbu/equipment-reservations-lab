{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "equipment-broker-monitor-upstream",
        "namespace": "equipment-recovery",
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "equipment-broker-monitor"
          }
        },
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "equipment"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "rabbitmq"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 15671,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "equipment-broker-monitor-management",
        "namespace": "equipment",
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "rabbitmq"
          }
        },
        "policyTypes": ["Ingress"],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "equipment-recovery"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "equipment-broker-monitor"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 15671,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ]
}
