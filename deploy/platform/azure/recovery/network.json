{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "equipment-recovery-live-database",
        "namespace": "equipment-recovery",
        "annotations": {
          "argocd.argoproj.io/sync-wave": "-40"
        }
      },
      "spec": {
        "podSelector": {
          "matchExpressions": [
            {
              "key": "app.kubernetes.io/name",
              "operator": "In",
              "values": ["equipment-backup-client", "equipment-restore-client"]
            }
          ]
        },
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "equipment"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "postgres"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 5432,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    },
    {
