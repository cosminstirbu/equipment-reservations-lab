variable "audit_transform_ready" {
  description = "Reviewed bind stage after live DCR qualification; false only during initial creation."
  type        = bool
  default     = false
}

variable "audit_diagnostics_ready" {
  description = "Reviewed enable stage after live workspace default-DCR qualification; flags alone never authorize ingestion."
  type        = bool
  default     = false
}

variable "audit_qualification" {
  description = "Private short-lived live-ARM observation generated by the shared qualification adapter, bound to exact source revision/generation and transform."
  type = object({
    version                  = number
    stage                    = string
    environment              = string
    generation               = string
    revision                 = string
    workspace_resource_id    = string
    dcr_resource_id          = string
    transform_sha256         = string
    observed_at              = string
    expires_at               = string
    workspace_default_dcr_id = string
    dcr_provisioning_state   = string
  })
  default = null

  validation {
    condition = var.audit_qualification == null ? true : (
      can(formatdate("YYYY-MM-DD'T'hh:mm:ssZ", var.audit_qualification.observed_at)) &&
      can(formatdate("YYYY-MM-DD'T'hh:mm:ssZ", var.audit_qualification.expires_at))
    )
    error_message = "Audit qualification must contain valid bounded observation timestamps."
  }
}

locals {
  audit_workspace_name        = "${local.prefix}-audit"
  audit_dcr_name              = "${local.prefix}-blob-audit-transform"
  audit_workspace_resource_id = "/subscriptions/${var.config.subscriptionId}/resourceGroups/${var.config.foundationBackend.resourceGroupName}/providers/Microsoft.OperationalInsights/workspaces/${local.audit_workspace_name}"
  audit_dcr_resource_id       = "/subscriptions/${var.config.subscriptionId}/resourceGroups/${var.config.foundationBackend.resourceGroupName}/providers/Microsoft.Insights/dataCollectionRules/${local.audit_dcr_name}"
  audit_stream                = "Microsoft-Table-StorageBlobLogs"
  # _ResourceId is platform metadata, not an input column for this stream.
  audit_columns = [
    "TimeGenerated", "AccountName", "Category", "OperationName",
    "StatusCode", "DurationMs", "ServerLatencyMs", "AuthenticationType",
    "RequesterObjectId", "Protocol", "TlsVersion"
  ]
  audit_transform_kql = "source | project ${join(", ", local.audit_columns)}"
  audit_qualification_valid = var.audit_qualification == null ? false : (
    var.audit_qualification.version == 1 &&
    contains(["bind", "enable"], var.audit_qualification.stage) &&
    var.audit_qualification.environment == var.config.environment &&
    var.audit_qualification.generation == var.config.generation &&
    var.audit_qualification.revision == var.config.gitRevision &&
    var.audit_qualification.workspace_resource_id == local.audit_workspace_resource_id &&
    var.audit_qualification.dcr_resource_id == local.audit_dcr_resource_id &&
    var.audit_qualification.transform_sha256 == sha256(local.audit_transform_kql) &&
    var.audit_qualification.dcr_provisioning_state == "Succeeded" &&
    timecmp(var.audit_qualification.observed_at, plantimestamp()) <= 0 &&
    timecmp(var.audit_qualification.observed_at, timeadd(plantimestamp(), "-30m")) >= 0 &&
    timecmp(var.audit_qualification.expires_at, plantimestamp()) > 0 &&
    timecmp(var.audit_qualification.expires_at, timeadd(var.audit_qualification.observed_at, "30m")) <= 0
  )
  audit_existing_dcr_valid = length(data.azurerm_monitor_data_collection_rule.audit_existing) == 0 ? false : (
    data.azurerm_monitor_data_collection_rule.audit_existing[0].kind == "WorkspaceTransforms" &&
    length(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow) == 1 &&
    toset(try(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow[0].streams, [])) == toset([local.audit_stream]) &&
    try(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow[0].transform_kql, "") == local.audit_transform_kql &&
    toset(try(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow[0].destinations, [])) == toset(["audit"]) &&
    try(data.azurerm_monitor_data_collection_rule.audit_existing[0].destinations[0].log_analytics[0].workspace_resource_id, "") == local.audit_workspace_resource_id &&
    try(length(data.azurerm_monitor_data_collection_rule.audit_existing[0].destinations[0].log_analytics), 0) == 1 &&
    try(data.azurerm_monitor_data_collection_rule.audit_existing[0].destinations[0].log_analytics[0].name, "") == "audit" &&
    contains([null, "", local.audit_stream], try(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow[0].output_stream, null)) &&
    contains([null, ""], try(data.azurerm_monitor_data_collection_rule.audit_existing[0].data_flow[0].built_in_transform, null)) &&
    alltrue([for name, destination in data.azurerm_monitor_data_collection_rule.audit_existing[0].destinations[0] : name == "log_analytics" || try(length(destination), 0) == 0])
  )
  audit_enable_qualified = var.audit_qualification == null ? false : (
    local.audit_qualification_valid &&
    var.audit_qualification.stage == "enable" &&
    var.audit_qualification.workspace_default_dcr_id == local.audit_dcr_resource_id
  )
}

data "azurerm_monitor_data_collection_rule" "audit_existing" {
  count = var.audit_transform_ready && var.audit_qualification != null ? 1 : 0

  name                = local.audit_dcr_name
  resource_group_name = var.config.foundationBackend.resourceGroupName
}

resource "terraform_data" "audit_stage_guard" {
  input = { transform = var.audit_transform_ready, diagnostics = var.audit_diagnostics_ready }

  lifecycle {
    precondition {
      condition     = !var.audit_diagnostics_ready || var.audit_transform_ready
      error_message = "Audit ingestion cannot be enabled before binding its workspace transformation."
    }
    precondition {
      condition     = !var.audit_transform_ready || (local.audit_qualification_valid && local.audit_existing_dcr_valid)
      error_message = "Binding requires fresh exact-revision/generation live qualification and matching existing DCR configuration."
    }
    precondition {
      condition     = !var.audit_diagnostics_ready || local.audit_enable_qualified
      error_message = "Ingestion requires fresh live qualification of the actual workspace default-DCR linkage."
    }
  }
}

resource "terraform_data" "audit_bound_guard" {
  count = var.audit_transform_ready ? 1 : 0
  input = local.audit_dcr_resource_id

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_log_analytics_workspace" "audit" {
  name                                    = local.audit_workspace_name
  resource_group_name                     = azurerm_resource_group.foundation.name
  location                                = var.config.region
  sku                                     = "PerGB2018"
  retention_in_days                       = 30
  immediate_data_purge_on_30_days_enabled = true
  daily_quota_gb                          = 0.03
  local_authentication_enabled            = false
  allow_resource_only_permissions         = false
  data_collection_rule_id                 = var.audit_transform_ready ? local.audit_dcr_resource_id : null
  tags                                    = local.tags
  depends_on                              = [terraform_data.audit_stage_guard, terraform_data.audit_bound_guard]

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_log_analytics_workspace_table" "blob_audit" {
  name                    = "StorageBlobLogs"
  workspace_id            = azurerm_log_analytics_workspace.audit.id
  retention_in_days       = 30
  total_retention_in_days = 30

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_monitor_data_collection_rule" "audit" {
  name                = local.audit_dcr_name
  resource_group_name = azurerm_resource_group.foundation.name
  location            = var.config.region
  kind                = "WorkspaceTransforms"
  tags                = local.tags
  depends_on          = [azurerm_log_analytics_workspace_table.blob_audit]

  destinations {
    log_analytics {
      name                  = "audit"
      workspace_resource_id = azurerm_log_analytics_workspace.audit.id
    }
  }

  data_flow {
    streams       = [local.audit_stream]
    destinations  = ["audit"]
    transform_kql = local.audit_transform_kql
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_monitor_diagnostic_setting" "blob_audit" {
  for_each = var.audit_diagnostics_ready ? {
    state    = azurerm_storage_account.state.id
    recovery = azurerm_storage_account.recovery.id
  } : {}

  name                           = "protected-blob-audit"
  target_resource_id             = "${each.value}/blobServices/default"
  log_analytics_workspace_id     = azurerm_log_analytics_workspace.audit.id
  log_analytics_destination_type = "Dedicated"
  depends_on                     = [terraform_data.audit_stage_guard, azurerm_monitor_data_collection_rule.audit]

  enabled_log {
    category = "StorageRead"
  }
  enabled_log {
    category = "StorageWrite"
  }
  enabled_log {
    category = "StorageDelete"
  }

  lifecycle {
    prevent_destroy = true
  }
}

resource "azurerm_role_assignment" "audit_query" {
  scope                = azurerm_log_analytics_workspace.audit.id
  role_definition_name = "Log Analytics Reader"
  principal_id         = var.config.operatorGroupObjectId
  principal_type       = "Group"
}

output "audit_workspace_resource_id" {
  description = "Dedicated retained audit workspace ARM ID for private live qualification."
  value       = azurerm_log_analytics_workspace.audit.id
}

output "audit_workspace_id" {
  description = "Dedicated audit workspace UUID for authenticated operator queries."
  value       = azurerm_log_analytics_workspace.audit.workspace_id
}

output "audit_dcr_resource_id" {
  description = "Workspace transformation DCR ARM ID; source output is not proof of actual default-DCR linkage."
  value       = azurerm_monitor_data_collection_rule.audit.id
}

output "audit_transform_sha256" {
  description = "Digest of the exact approved stored-column KQL projection."
  value       = sha256(local.audit_transform_kql)
}

output "audit_stream" {
  description = "Only the native StorageBlobLogs stream may feed the protected audit table."
  value       = local.audit_stream
}


