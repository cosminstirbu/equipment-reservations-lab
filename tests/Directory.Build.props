<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'TestSupport'">
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'TestSupport'">
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageReference
      Include="Microsoft.Testing.Extensions.CodeCoverage"
      Version="18.12.0"
    />
  </ItemGroup>
</Project>
