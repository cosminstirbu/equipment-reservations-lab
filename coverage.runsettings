<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <IncludeTestAssembly>False</IncludeTestAssembly>
          <CodeCoverage>
            <EnableStaticManagedInstrumentation
            >True</EnableStaticManagedInstrumentation>
            <ModulePaths>
              <Include>
                <ModulePath
                >.*[\\/](Inventory|Reservations|Notifications|IdentityAccess|Persistence|ReservationMessaging|DatabaseBootstrap|IdentityBootstrap|BrokerBootstrap|ApiDocumentation|ServiceDefaults)\.dll$</ModulePath>
              </Include>
            </ModulePaths>
            <Sources>
              <Exclude>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
