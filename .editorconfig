root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
dotnet_analyzer_diagnostic.category-Style.severity = warning
# Roslyn's build-time IDE0005 needs XML documentation output. The mandatory
# dotnet format style --severity info gate checks this suggestion instead.
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0330.severity = warning
csharp_prefer_system_threading_lock = true
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_sort_system_directives_first = true

[*.md]
trim_trailing_whitespace = false

[**/{bin,obj,node_modules,dist,.angular}/**]
generated_code = true
