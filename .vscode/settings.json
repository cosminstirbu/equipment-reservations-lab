{
  "editor.formatOnSave": true,
  "dotnet.unitTests.runSettingsPath": "${workspaceFolder}/coverage.runsettings",
  "dotnet.server.sourceGeneratorExecution": "Automatic",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "[typescript][javascript][html][css][json][jsonc][xml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.csproj": "xml",
    "*.props": "xml",
    "*.targets": "xml",
    "*.slnx": "xml"
  },
  "eslint.workingDirectories": [
    {
      "directory": "."
    }
  ],
  "nodejs-testing.include": ["tests/DeployedApplication"],
  "nodejs-testing.concurrency": 1,
  "nodejs-testing.extensions": [
    {
      "extensions": ["mjs"],
      "parameters": [
        "--env-file-if-exists=${workspaceFolder}/.local/kubernetes/deployed-tests.env"
      ]
    }
  ]
}
