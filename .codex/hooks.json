{
  "description": "Format only files named by a completed edit; agent instructions cover shell writes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/format-after-edit.mjs\"",
            "timeout": 180,
            "statusMessage": "Formatting edited source files"
          }
        ]
      }
    ]
  }
}
